{
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{content/**,public/index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/post/:slug",
      "destination": "/api/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js"
    }
  ]
}
